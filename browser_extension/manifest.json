{
  "manifest_version": 3,
  "name": "Smart Rename – AI Download Renamer",
  "short_name": "Smart Rename",
  "version": "2.0.0",
  "description": "Reads every file you download and saves it with an exact, descriptive name written by AI from its real content.",
  "permissions": ["downloads", "storage", "notifications"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Smart Rename",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
